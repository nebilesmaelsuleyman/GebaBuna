# ==============================================================================
# GebaBuna (ገባ ቡና) / Buna Fair Price — Environment Configuration
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_here

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/buna_fair_price

# Redis High-Speed In-Memory Caching Layer
# Supports TCP URL or Unix domain socket (e.g., /tmp/redis.sock)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
REDIS_TTL_DEFAULT=300

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
ENABLE_TELEGRAM_BOT=true
BOT_API_KEY=buna_bot_secure_api_key_jimma_2026

# AI Voice-First Services (Addis AI: Afaan Oromoo & Amharic STT/TTS)
ADDIS_API_KEY=your_addis_ai_api_key

# Multimodal Computer Vision (Google Gemini for ECX Coffee Bean Grading)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Client Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/BunaJimmaBot
